{
  "redirects": [
    { "source": "/proyectos", "destination": "/casos", "statusCode": 301 },
    { "source": "/trabajos/:slug", "destination": "/casos", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/propuesta", "destination": "/_spa.html" },
    { "source": "/propuesta/:path*", "destination": "/_spa.html" },
    { "source": "/robots", "destination": "/_spa.html" },
    { "source": "/diagnostico-ia", "destination": "/_spa.html" },
    { "source": "/sistemas-conectados", "destination": "/_spa.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://media.nimbodata.com https://bzrcdn.openai.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://media.nimbodata.com https://bzr.openai.com https://bzrcdn.openai.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
