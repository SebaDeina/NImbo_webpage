# Notificaciones del formulario de contacto (Vercel Function /api/contact)
# En local: copiá a .env. En Vercel: Settings → Environment Variables.

# Slack — Incoming Webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# Resend — email opcional (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM=NIMBO <contacto@nimbodata.com>
CONTACT_NOTIFY_EMAIL=contacto@nimbodata.com

# OpenAI — chatbot con IA (solo servidor, nunca en el frontend)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Agendador de llamadas (/agendar → /api/agendar)
# Google Calendar de Nimbo: cliente OAuth "App de escritorio" + refresh token.
# El refresh token se saca con: node scripts/google-calendar-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendario donde se crean las llamadas (primary = el principal de la cuenta autorizada)
GOOGLE_CALENDAR_ID=primary

# Clave para firmar el "No soy un robot" (cualquier texto largo al azar; sin ella no se reserva en producción)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_SECRET=
